			"name": "fiction books - task 2",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Get fiction books\", () => {\r",
							"    var books = pm.response.json();\r",
							"    pm.expect(Array.isArray(books)).to.be.true;\r",
							"    \r",
							"    for (var index = 0; index < books.length; index++) {\r",
							"        pm.expect(books[index].type).to.be.eql(\"fiction\");\r",
							"    }\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{URL}}/books/?type=fiction",
					"host": [
						"{{URL}}"
					],
					"path": [
						"books",
						""
					],
					"query": [
						{
							"key": "type",
							"value": "fiction"
						}
					]
				}
			},
			"response": []
		},
