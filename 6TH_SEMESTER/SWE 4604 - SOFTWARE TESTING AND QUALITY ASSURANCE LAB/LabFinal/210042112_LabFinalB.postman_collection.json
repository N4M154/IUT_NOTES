		{
			"name": "Search Pliers",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Searching for pliers\", ()=>{\r",
							"    var jsonData = pm.response.json();\r",
							"    var products = jsonData.data;\r",
							"\r",
							"    pm.expect(products.length).to.equal(4);\r",
							"\r",
							"});\r",
							"\r",
							"pm.test(\"Find out-of-stock plier\", ()=>{\r",
							"    var jsonData = pm.response.json();\r",
							"    var outOfStockPlier = null;\r",
							"\r",
							"    for (var i = 0; i < jsonData.data.length; i++) {\r",
							"        if (!jsonData.data[i].in_stock) {\r",
							"            outOfStockPlier = jsonData.data[i].id || jsonData.data[i].product_id;\r",
							"            break;\r",
							"        }\r",
							"    }\r",
							"    pm.globals.set(\"out_plier\", outOfStockPlier);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
